# =============================================================================
# AI Moderation Cog — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file.

# --- DigitalOcean Inference API (fallback AI provider) ---
# Get a key at https://cloud.digitalocean.com/products/ai-models
DO_API_KEY=
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DO_PROFILE_MODEL=deepseek-4-flash

# --- DeepSeek Web (primary AI provider, browser-based, no API key) ---
# Set to "true" to enable the DeepSeek web client.
DEEPSEEK_WEB_ENABLED=false
DEEPSEEK_WEB_PRIMARY_TIMEOUT=30

# --- Web Search Providers (optional, for research mode) ---
# At least one enables web search for research queries.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# --- Rate Limiting ---
AI_RATE_LIMIT_CALLS=30
AI_RATE_LIMIT_WINDOW=60

# --- Database ---
# Path to the SQLite database file (relative to the bot's working directory).
AI_MODERATION_DB_PATH=data/ai_moderation.db

# --- Discord Bot Token (your existing bot) ---
# This is NOT used by the cog directly — your bot loads it.
DISCORD_TOKEN=
