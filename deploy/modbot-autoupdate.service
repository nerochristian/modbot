[Unit]
Description=Deploy latest ModBot commit from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/modbot-autoupdate.env
ExecStart=/usr/bin/env bash /opt/modbot/scripts/vps_deploy.sh

# IMPORTANT for multi-bot VPS hosts:
# install_vps_autoupdate.sh now generates a unique service per bot, e.g.
#   modbot-autoupdate.service -> /etc/modbot-autoupdate.env -> /opt/modbot
#   lifesim-autoupdate.service -> /etc/lifesim-autoupdate.env -> /opt/lifesim
# Do not reuse this exact unit name/env file for multiple bots.
