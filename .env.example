# Discord bot and OAuth application
DISCORD_TOKEN=
SUPPORTBOT_DISCORD_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VERIFICATION_LINK_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_PERMISSIONS=8
OWNER_IDS=

# Dashboard public origin and session security
DASHBOARD_PUBLIC_URL=https://dashboard.example.com
DASHBOARD_PORT=10547
DASHBOARD_HOSTNAME=127.0.0.1
SESSION_SECRET=
DISCORD_TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=true

# Keep the dashboard identity store separate from the bot moderation database.
DASHBOARD_DATABASE_URL=file:/opt/modbot/dashboard/data/dashboard.db
BOT_DATABASE_URL=postgresql://user:password@localhost:5432/modbot

# Bot database configuration (BOT_DATABASE_URL takes precedence in the dashboard)
DB_MODE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/modbot

# AI moderation provider
#
# OpenRouter is the only provider. Every lane is an OpenRouter model reached
# through OPENROUTER_API_KEY, and lanes are kept apart by MODEL so retuning one
# cannot silently take over another. AI_PROVIDER is informational only; it is
# reported by /aimod status and cannot select a different vendor.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Guild-level default model, shown in /aimod status and used by the protected
# moderation lane when a guild sets no override of its own.
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Output-token ceiling for conversation replies (default 16000, clamped
# 1000-64000). This is headroom, not a target: long replies are split into
# Discord-sized chunks and you are billed only for tokens actually generated.
# Keep it well above your longest expected answer, because reasoning models
# count hidden reasoning tokens against this limit -- a budget that is too low
# truncates the answer or returns an empty reply with finish_reason="length".
AI_MAX_TOKENS_CHAT=16000

# --- Conversation lanes ---
# The talking lane handles ordinary text conversation and is deliberately never
# given the web-search tool, images, or research prompts; it is chosen for
# conversational tone. Luna handles searched conversation and is pinned in code.
# The vision model answers image turns. Sonar is the live-research pre-fetch
# that supplies the verified source links, and the research writer turns Sonar's
# evidence into the report. Ling 2.6 Flash classifies normal/search/research.
OPENROUTER_CHAT_MODEL=~deepseek/deepseek-v4-flash-latest
# Overrides the talking lane specifically, if you want it to differ from
# OPENROUTER_CHAT_MODEL.
OPENROUTER_CHAT_MODEL_TALKING=
# Models that ship reasoning on by default measured ~5.1s per reply versus
# ~0.6-1.4s with it off, and bill hidden reasoning tokens against max_tokens.
# Set to false only if you want chain-of-thought on casual chat.
OPENROUTER_CHAT_DISABLE_REASONING=true
# Live-research pre-fetch. Must be a model that returns real citations.
OPENROUTER_RESEARCH_MODEL=perplexity/sonar
OPENROUTER_RESEARCH_WRITER_MODEL=
OPENROUTER_VISION_MODEL=google/gemini-3.6-flash
OPENROUTER_TIMEOUT=60

# --- Protected lanes ---
# Moderation, action routing, image screening, and memory curation: the calls
# whose output can mute, delete, or ban. The lane refuses any model not named
# here, so a decision cannot bring its own model along. The RELAYROUTER_*
# spellings of these settings are still honoured for older deployments.
OPENROUTER_MODERATION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_MODERATION_VISION_MODEL=
OPENROUTER_MODERATION_FALLBACK_MODELS=nvidia/nemotron-3-nano-30b-a3b
OPENROUTER_MODERATION_VISION_FALLBACK_MODELS=
OPENROUTER_MODERATION_TIMEOUT=20
OPENROUTER_MODERATION_VISION_TIMEOUT=45
# Background lanes. No user waits on these, so a cheaper rate-limited model is
# an acceptable trade. Both default to the moderation model.
OPENROUTER_MEMORY_MODEL=
OPENROUTER_ROUTER_MODEL=
# Second-attempt model for generated-action planning.
OPENROUTER_EXECUTION_FALLBACK_MODEL=
# Automatic NSFW/gore image screening, kept isolated from the text moderation
# model so retuning one cannot repoint the other.
OPENROUTER_IMAGE_SCREEN_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Google-grade image identification. GEMINI_API_KEY enables a direct Gemini
# multimodal request with native Google Search grounding. Cloud Vision Web
# Detection adds OCR plus full/partial reverse-image matches; its API must be
# enabled on the key's Google Cloud project. GOOGLE_CLOUD_VISION_API_KEY falls
# back to GEMINI_API_KEY when omitted.
GEMINI_API_KEY=
GOOGLE_IMAGE_SEARCH_MODEL=gemini-3.6-flash
GOOGLE_IMAGE_SEARCH_TIMEOUT=90
GOOGLE_CLOUD_VISION_API_KEY=
GEMINI_GENERATE_CONTENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_CLOUD_VISION_URL=https://vision.googleapis.com/v1/images:annotate
