# Discord bot and OAuth application
DISCORD_TOKEN=
SUPPORTBOT_DISCORD_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VERIFICATION_LINK_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_PERMISSIONS=8
OWNER_IDS=

# Dashboard public origin and session security
DASHBOARD_PUBLIC_URL=https://dashboard.example.com
DASHBOARD_PORT=10547
DASHBOARD_HOSTNAME=127.0.0.1
SESSION_SECRET=
DISCORD_TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=true

# Keep the dashboard identity store separate from the bot moderation database.
DASHBOARD_DATABASE_URL=file:/opt/modbot/dashboard/data/dashboard.db
BOT_DATABASE_URL=postgresql://user:password@localhost:5432/modbot

# Bot database configuration (BOT_DATABASE_URL takes precedence in the dashboard)
DB_MODE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/modbot

# AI moderation provider
AI_PROVIDER=aimodel
# All roles default to kimi-k3-fast (fast, capable, the bot-wide standard).
# Other valid options on the aimodel provider:
# accounts/aimodel/models/claude-fable-5 (highest intelligence)
# accounts/aimodel/models/minimax-m2.7 (general use)

# Standard chat completion endpoint overrides
AI_MODEL=accounts/aimodel/models/kimi-k3-fast
AIMODEL_API_KEY=
AIMODEL_BASE_URL=https://aimodel.lol/v1

# Output-token ceiling for conversation replies (default 16000, clamped
# 1000-64000). This is headroom, not a target: long replies are split into
# Discord-sized chunks and you are billed only for tokens actually generated.
# Keep it well above your longest expected answer, because reasoning models
# count hidden reasoning tokens against this limit -- a budget that is too low
# truncates the answer or returns an empty reply with finish_reason="length".
AI_MAX_TOKENS_CHAT=16000

# Fallback and specific use-case overrides
# Ordinary text conversation only. Search/research and vision stay on Luna.
AIMODEL_CONVERSATION_API_KEY=
AIMODEL_CONVERSATION_MODEL=grok-4.5
AIMODEL_CHAT_MODEL=accounts/aimodel/models/kimi-k3-fast
AIMODEL_MODERATION_MODEL=accounts/aimodel/models/kimi-k3-fast
AIMODEL_EXECUTION_FALLBACK_MODEL=accounts/aimodel/models/kimi-k3-fast
AIMODEL_ROUTER_MODEL=accounts/aimodel/models/kimi-k3-fast
AIMODEL_MEMORY_MODEL=accounts/aimodel/models/kimi-k3-fast
AIMODEL_VISION_MODEL=accounts/aimodel/models/kimi-k3-fast
AIMODEL_FALLBACK_MODELS=accounts/aimodel/models/minimax-m2.7,accounts/aimodel/models/claude-fable-5
AIMODEL_CHAT_FALLBACK_MODELS=accounts/aimodel/models/minimax-m2.7,accounts/aimodel/models/claude-fable-5
AIMODEL_VISION_FALLBACK_MODELS=accounts/aimodel/models/claude-fable-5
AIMODEL_TIMEOUT=90
AIMODEL_VISION_TIMEOUT=120
RELAYROUTER_API_KEY=
RELAYROUTER_BASE_URL=https://relayrouter.org/v1
RELAYROUTER_CHAT_MODEL=claude-test-opus-4-8
RELAYROUTER_MODERATION_MODEL=claude-test-opus-4-8
RELAYROUTER_VISION_MODEL=claude-test-opus-4-8
RELAYROUTER_ROUTER_MODEL=claude-test-opus-4-8
RELAYROUTER_MEMORY_MODEL=gpt-5-6-luna
RELAYROUTER_FALLBACK_MODELS=gpt-5.5
RELAYROUTER_VISION_FALLBACK_MODELS=gpt-5.5
RELAYROUTER_TIMEOUT=90
RELAYROUTER_VISION_TIMEOUT=45

# GLM 5.2 handles ordinary text conversation ("talking") and is deliberately
# never given the web-search tool, images, or research prompts. It was chosen
# for conversational tone over Luna/Grok. Luna handles searched conversation,
# vision, and sourced research. Sonar is the live-research pre-fetch that
# supplies the verified source links. Ling 2.6 Flash classifies
# normal/search/research turns. Nemotron remains on protected tasks.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordinary talking lane (text-only, no search tool).
OPENROUTER_CHAT_MODEL_TALKING=z-ai/glm-5.2
# GLM enables reasoning implicitly, which measured ~5.1s per reply versus
# ~0.6-1.4s with it off, and bills hidden reasoning tokens against max_tokens.
# Set to false only if you want chain-of-thought on casual chat.
OPENROUTER_CHAT_DISABLE_REASONING=true
# Live-research pre-fetch. Must be a model that returns real citations.
# NOTE: this goes through OpenRouter, not RELAYROUTER_BASE_URL — relayrouter.org
# serves no perplexity/* model and returned HTTP 400 for every research turn.
OPENROUTER_RESEARCH_MODEL=perplexity/sonar
# Searched/vision/research answer model. Pinned in code.
OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna
# Automatic NSFW/gore image screening stays isolated from conversation and
# AiModel moderation configuration.
OPENROUTER_IMAGE_SCREEN_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_TIMEOUT=60

# Google-grade image identification. GEMINI_API_KEY enables a direct Gemini
# multimodal request with native Google Search grounding. Cloud Vision Web
# Detection adds OCR plus full/partial reverse-image matches; its API must be
# enabled on the key's Google Cloud project. GOOGLE_CLOUD_VISION_API_KEY falls
# back to GEMINI_API_KEY when omitted.
GEMINI_API_KEY=
GOOGLE_IMAGE_SEARCH_MODEL=gemini-3.6-flash
GOOGLE_IMAGE_SEARCH_TIMEOUT=90
GOOGLE_CLOUD_VISION_API_KEY=
GEMINI_GENERATE_CONTENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_CLOUD_VISION_URL=https://vision.googleapis.com/v1/images:annotate

# When RELAYROUTER_BASE_URL points to OpenRouter, the protected lane is pinned
# to nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free and uses
# OPENROUTER_API_KEY. Other requested/fallback models are rejected.

# Optional DeepSeek browser lane for native web research only.
DEEPSEEK_WEB_ENABLED=false
