# Discord bot and OAuth application
DISCORD_TOKEN=
SUPPORTBOT_DISCORD_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VERIFICATION_LINK_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_PERMISSIONS=8
OWNER_IDS=

# Dashboard public origin and session security
DASHBOARD_PUBLIC_URL=https://dashboard.example.com
DASHBOARD_PORT=10547
DASHBOARD_HOSTNAME=127.0.0.1
SESSION_SECRET=
DISCORD_TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=true

# Keep the dashboard identity store separate from the bot moderation database.
DASHBOARD_DATABASE_URL=file:/opt/modbot/dashboard/data/dashboard.db
BOT_DATABASE_URL=postgresql://user:password@localhost:5432/modbot

# Bot database configuration (BOT_DATABASE_URL takes precedence in the dashboard)
DB_MODE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/modbot

# AI moderation provider
#
# Legion Edge is the only TEXT provider. Every text lane -- talking, routing,
# search synthesis, research, moderation, memory -- is a Legion model reached
# through LEGION_API_KEY, and lanes are kept apart by MODEL so retuning one
# cannot silently take over another.
#
# Google is kept for VISION only, and out of necessity: all nine Legion models
# are text-only, so without a Gemini key the bot cannot see images at all.
#
# Legion Edge also has NO web search (no plugins, no web_search tool), so
# search and research are done by the bot's own harness -- see SEARCH BACKENDS
# below. AI_PROVIDER is informational only.
AI_PROVIDER=legionedge
LEGION_API_KEY=
LEGION_BASE_URL=https://inference.legionedge.ai/v1

# Output-token ceiling for conversation replies (default 16000, clamped
# 1000-64000). This is headroom, not a target. Keep it well above your longest
# expected answer, because reasoning models count hidden reasoning tokens
# against this limit -- too low truncates the answer or returns an empty reply.
AI_MAX_TOKENS_CHAT=16000

# --- Text lanes ---
#
# Defaults are benchmarked against this endpoint, not guessed. Leave them unset
# unless you have measured something better.
#
#   deepseek-v4-flash  latency FLAT vs context (4.4s at 97k tokens) -> chat
#   deepseek-v4-pro    wrote an 8-source report in 7.9s citing 8/8 -> research
#   kimi-k3            only model to score 12/12 on the routing eval -> router
#
# Avoid: qwen3-0.6b leaks raw <think> into replies; qwen3-6-27b burns hundreds
# of reasoning tokens on trivial prompts; kimi-k3-turbo is slower than kimi-k3
# with flakier tool calls; qwen3-8-27b spent an entire 4000-token budget on
# hidden reasoning and returned nothing.
LEGION_CHAT_MODEL=deepseek-v4-flash
LEGION_SEARCH_MODEL=deepseek-v4-flash
LEGION_RESEARCH_PLANNER_MODEL=kimi-k3
LEGION_RESEARCH_WRITER_MODEL=deepseek-v4-pro
LEGION_RESEARCH_WRITER_FALLBACK_MODELS=kimi-k3
LEGION_CHAT_DISABLE_REASONING=true
LEGION_TIMEOUT=60

# --- Conversation router ---
# Reads the recent thread and decides chat / search / research, plus whether
# the turn is moderation work. Sees the thread so that follow-ups like "and
# tomorrow?" route on what they follow up on.
LEGION_ROUTER_MODEL=kimi-k3
# How much of the thread it sees. Bigger resolves longer follow-up chains and
# costs latency on every conversational message.
ROUTER_CONTEXT_CHARS=12000
ROUTER_TIMEOUT=8
# Outer deadline; past this the turn proceeds unrouted (as ordinary chat).
ROUTER_DEADLINE=10

# --- Protected lanes ---
# Moderation, action routing, image screening, and memory curation: the calls
# whose output can mute, delete, or ban. The lane refuses any model not named
# here, so a decision cannot bring its own model along. The OPENROUTER_* and
# RELAYROUTER_* spellings are still honoured for older deployments.
LEGION_MODERATION_MODEL=deepseek-v4-flash
LEGION_MODERATION_FALLBACK_MODELS=deepseek-v4-pro
LEGION_MODERATION_TIMEOUT=20
LEGION_MODERATION_VISION_TIMEOUT=45
# Background lanes. No user waits on these. Both default to the moderation model.
LEGION_MEMORY_MODEL=
LEGION_ACTION_ROUTER_MODEL=
# Behaviour profiling (/profile).
LEGION_PROFILE_MODEL=kimi-k3
LEGION_PROFILE_FALLBACK_MODEL=deepseek-v4-flash
# Second-attempt model for generated-action planning.
OPENROUTER_EXECUTION_FALLBACK_MODEL=

# =============================================================================
# SEARCH BACKENDS
# =============================================================================
#
# Legion Edge cannot search, so the bot runs its own harness: it queries a SERP
# backend, ranks the results by authority, then actually opens and reads the
# best pages. Every backend below is optional -- with none configured the chain
# falls through to DuckDuckGo and the bot still works, just less reliably.
#
# Recommended setup costs nothing:
#   - Apify: $5 of platform credit per billing cycle, renewing, no card.
#     ~3,300 Google queries/month. Batch-native, so a 5-query research run is
#     ONE billable call. Accepts PayPal if you ever outgrow the free tier.
#   - Serper: 2,500 free queries, no card, ~1-2s -- the fast search lane.
#   - DuckDuckGo: free fallback, but it answers with an HTTP 202 challenge
#     after roughly three rapid requests, hence the pacing below.
APIFY_TOKEN=
# The default is a COMMUNITY actor, not an Apify-official one: it can change
# price or be delisted. apify/google-search-scraper is the official drop-in,
# on the same platform and the same free credits.
APIFY_SERP_ACTOR=serp.cheap.ofc/cheapest-google-search
SERPER_API_KEY=
SEARCH_COUNTRY=us

# Backend order per lane. Research prefers batch economy, the interactive
# search lane prefers latency.
RESEARCH_BACKEND_ORDER=apify,serper,ddg_http,ddg_browser
SEARCH_BACKEND_ORDER=serper,apify,ddg_http,ddg_browser
# Safety caps on calls per backend (0 = unmetered). The harness fails a backend
# over BEFORE its credits run out rather than after.
APIFY_MAX_CALLS=0
SERPER_MAX_CALLS=0
# Repeat and overlapping queries are free for this long. The single biggest
# saver, because it works across users and across both lanes.
SEARCH_CACHE_TTL=900
# Last-resort DuckDuckGo through a real headless browser (Playwright is already
# a dependency). Set to 0 to disable; each context costs ~300-500MB.
SEARCH_ENABLE_BROWSER=1

# --- Page reading ---
# How many pages each lane opens. Research "finds wide, reads narrow": it
# gathers 40-70 candidate URLs and reads the best RESEARCH_MAX_PAGES of them.
SEARCH_PAGES=4
RESEARCH_MAX_PAGES=14
# Below this many successfully-read pages, a research run is marked degraded.
RESEARCH_MIN_PAGES=6
RESEARCH_RESULTS_PER_QUERY=10
# At most this many pages from any one site, so one domain cannot occupy the
# whole shortlist.
RESEARCH_PER_DOMAIN=2
SEARCH_FETCH_CONCURRENCY=10
SEARCH_FETCH_TIMEOUT=8
# Downloads are capped mid-stream: article text is always in the first few
# hundred KB, and every extra byte is HTML-parsing time.
SEARCH_MAX_PAGE_BYTES=900000
# Roughly a quarter of sites refuse a plain client (Reuters 401,
# StackOverflow 403, GitHub 400). Those are retried through r.jina.ai, which
# renders the page and returns clean text. Set to 0 to keep target URLs off a
# third-party service; blocked pages then fall back to their search snippet.
SEARCH_READER_FALLBACK=1
# Source-text budget handed to the writer, shared fairly across pages.
RESEARCH_PAGE_CHARS=4000
RESEARCH_TOTAL_CHARS=50000
SEARCH_PAGE_CHARS=3000
SEARCH_TOTAL_CHARS=12000
RESEARCH_WRITE_TIMEOUT=90

# --- Vision (Google) ---
# Required for ANY image understanding: Legion Edge is text-only, so without
# GEMINI_API_KEY the bot cannot see attachments at all. Cloud Vision Web
# Detection adds OCR plus reverse-image matches; its API must be enabled on the
# key's Google Cloud project. GOOGLE_CLOUD_VISION_API_KEY falls back to
# GEMINI_API_KEY when omitted.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_IMAGE_SCREEN_MODEL=
GEMINI_MODERATION_VISION_MODEL=
GOOGLE_IMAGE_SEARCH_MODEL=gemini-3.6-flash
GOOGLE_IMAGE_SEARCH_TIMEOUT=90
GOOGLE_CLOUD_VISION_API_KEY=
GEMINI_GENERATE_CONTENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_CLOUD_VISION_URL=https://vision.googleapis.com/v1/images:annotate
