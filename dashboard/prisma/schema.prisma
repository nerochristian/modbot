// Nebula SaaS — Prisma schema
// SQLite by default for zero-config local dev. To scale to Postgres:
//   1. change `provider` to "postgresql"
//   2. set DATABASE_URL to your Postgres connection string
//   3. run `npm run db:push`
// JSON-shaped data is stored as String columns for cross-database portability
// (see src/lib/json.ts for typed (de)serialization helpers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Identity & access — Discord-first OAuth
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("viewer") // admin | manager | viewer
  status        String   @default("active") // active | invited | suspended
  avatarColor   String   @default("#6366f1")
  title         String?
  phone         String?
  timezone      String   @default("UTC")
  bio           String?
  twoFactorEnabled Boolean @default(false)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  // Discord is the primary identity for production dashboard accounts.
  // Existing local demo accounts remain valid while deployments migrate.
  discordId             String?   @unique
  discordUsername       String?
  discordGlobalName     String?
  discordAvatar         String?
  discordAccessToken    String?
  discordRefreshToken   String?
  discordTokenExpiresAt DateTime?

  sessions        Session[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  auditLogs       AuditLog[]
  reports         Report[]
  savedViews      SavedView[]
  dashboardConfig DashboardConfig?
  subscription    Subscription?
  invoices        Invoice[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti        String   @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// Role -> permission grants. Editable by admins so the permission matrix is
// data-driven rather than hard-coded.
model RolePermission {
  id         String  @id @default(cuid())
  role       String  // admin | manager | viewer
  permission String  // e.g. "users.write", "billing.read"
  allowed    Boolean @default(true)

  @@unique([role, permission])
}

// ---------------------------------------------------------------------------
// Customers (the SaaS's end-customers shown across the dashboard)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Community members — the people being moderated in the Discord server
// ---------------------------------------------------------------------------

model Member {
  id           String   @id @default(cuid())
  username     String // Discord username, e.g. "shadowfox"
  displayName  String // server nickname / global display name
  discordId    String   @unique // 17-19 digit snowflake
  avatarColor  String   @default("#5865f2")
  standing     String   @default("good") // good | watchlist | muted | banned | left
  riskLevel    String   @default("low") // low | medium | high | critical
  warnings     Int      @default(0)
  messages     Int      @default(0)
  roles        String   @default("[]") // JSON array of role names
  note         String? // moderator note
  joinedAt     DateTime @default(now())
  lastActiveAt DateTime @default(now())

  cases   Case[]
  appeals Appeal[]

  @@index([standing])
  @@index([riskLevel])
}

// ---------------------------------------------------------------------------
// Cases / infractions — the moderation action log
// ---------------------------------------------------------------------------

model Case {
  id         String   @id @default(cuid())
  ref        Int      @unique // human case number, e.g. 421 -> #CASE-0421
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       String // note | warn | mute | timeout | kick | ban | unban
  severity   String   @default("low") // low | medium | high | critical
  status     String   @default("open") // open | resolved | expired | appealed
  reason     String
  moderator  String // display name of the acting moderator
  moderatorId String?
  channel    String? // originating channel name
  evidence   String? // JSON array of evidence links/notes
  expiresAt  DateTime? // for temporary mutes/timeouts/bans
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  appeals Appeal[]

  @@index([memberId])
  @@index([type])
  @@index([status])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// Automod rules — the automated filter/enforcement engine
// ---------------------------------------------------------------------------

model AutomodRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  trigger     String // keyword | regex | spam | mention_spam | invite | link | caps | attachment
  pattern     String? // keywords/regex/thresholds depending on trigger
  action      String   @default("delete") // delete | warn | mute | timeout | kick | ban | flag
  severity    String   @default("low") // low | medium | high | critical
  exemptRoles String   @default("[]") // JSON array of role names
  enabled     Boolean  @default(true)
  hits        Int      @default(0) // number of times this rule has fired
  lastTriggeredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([enabled])
  @@index([trigger])
}

