# ---------------------------------------------------------------------------
# Environment configuration
# These defaults work out of the box for local development.
# For production, override AUTH_SECRET and DATABASE_URL.
# ---------------------------------------------------------------------------

# Database. SQLite by default (zero-config). To scale, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at a Postgres instance.
DATABASE_URL="file:./dev.db"

# Auth. Secret used to sign session JWTs. CHANGE THIS in production.
AUTH_SECRET="dev-insecure-secret-change-me-in-production-please-01234567890"

# Session lifetime in seconds (default 7 days).
AUTH_SESSION_TTL="604800"

# App metadata (safe to expose to the client).
NEXT_PUBLIC_APP_NAME="Nebula"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
